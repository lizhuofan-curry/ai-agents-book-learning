# 复制为项目根目录的.env，按实验填写对应平台的API Key。
# API Key只在本地填写，不粘贴到聊天，也不提交到Git。

# 实验1.2使用Moonshot官方API。
MOONSHOT_API_KEY=
# 与官方实验config.py的默认地址一致。
KIMI_BASE_URL=https://api.moonshot.cn/v1
SEARCH_TIMEOUT=180

# 实验1.1后续使用DeepSeek，默认选择成本较低且支持工具调用的Flash模型。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=180

# 实验1.4使用阿里云百炼华北2（北京）地域的万相文生图。
# API Key与请求地址必须属于同一地域。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
WANX_MODEL=wan2.2-t2i-flash
WANX_SIZE=1024*1024
IMAGE_POLL_INTERVAL=3
IMAGE_POLL_TIMEOUT=180
